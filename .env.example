# ============================================================
# PeerTest - Ortam Degiskenleri (sablon). Gercek degerleri .env'e yazin.
# .env dosyasi .gitignore'da; ASLA repo'ya commit etmeyin.
# ============================================================

# --- Veritabani (Neon Postgres tavsiye edilir; herhangi bir Postgres calisir) ---
# Pooled (-pooler) baglanti onerilir.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"

# --- Telegram ---
# @BotFather'dan alinan bot token (DM bildirimleri + bot deep-link login icin).
TELEGRAM_BOT_TOKEN=""
# Bot kullanici adi (@ olmadan). /start deep-link icin client-side gerekir.
PUBLIC_TELEGRAM_BOT_USERNAME=""
# Bot webhook'unu dogrulamak icin gizli (telegram setWebhook secret_token ile eslesir).
# Olusturmak icin: `openssl rand -hex 32`
TELEGRAM_WEBHOOK_SECRET=""
# Ilk admin(ler)in Telegram sayisal ID'leri (virgulle ayrik). Bu kullanicilar giriste admin olur.
ADMIN_TELEGRAM_IDS=""

# Yerel test girisi (SADECE gelistirme). Prod'da bos birakin. /api/auth/dev-login'i acar.
DEV_LOGIN=""

# --- Uygulama ---
# Canli origin (bot login complete URL'i icin). Dev'de http://localhost:5173
PUBLIC_BASE_URL="http://localhost:5173"

# --- Ekran goruntusu upload sagayicisi ---
# Varsayilan provider prntscr; secretKey gerektirir. Imgbb/imgur/catbox/freeimage/zerox0/vercel_blob
# da desteklenir (admin panelden secilir). Provider'in API anahtarini buraya yazin.
UPLOAD_SECRET_KEY=""

# --- Cron ---
# Vercel Cron endpoint'ini korumak icin gizli (Authorization: Bearer header ile dogrulanir).
# Olusturmak icin: `openssl rand -base64 32`
CRON_SECRET=""
